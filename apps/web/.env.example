# ==============================================================================
# ArtisanConnect Environment Configuration Template
# Duplicate this file to .env.local for local development or set in hosting provider.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="https://artisan-connect.netlify.app"

# ------------------------------------------------------------------------------
# Supabase Authentication & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase / AWS RDS / Neon)
# ------------------------------------------------------------------------------
# Transaction pooler connection string (Port 6543, pgbouncer=true) for serverless queries:
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection string (Port 5432) for running migrations (Prisma CLI):
DIRECT_URL="postgresql://postgres.your-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Mapbox (Interactive Map & Geocoding)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="ArtisanConnect <notifications@artisanconnect.com.gh>"

# ------------------------------------------------------------------------------
# AI Dispute Resolution & Semantic Search (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# Paystack Payment Gateway (Ghana Mobile Money & Card Payments - Pending)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
# PAYSTACK_SECRET_KEY="your-paystack-secret-key"
# PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"
